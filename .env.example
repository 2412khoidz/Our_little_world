# Cấu hình Supabase (tùy chọn khi phát triển local)
# Khi chạy npm run dev với cả hai biến trống, app dùng Dev LAN. Bản production cần điền hai biến.
#
# KHÔNG BAO GIỜ đặt service_role key vào file .env hoặc frontend!

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Bật farm/fish donor trên bản build preview (npm run build && preview) khi dùng Dev LAN
# VITE_OLW_DONOR_ECONOMY=1
