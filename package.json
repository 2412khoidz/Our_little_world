{
  "name": "our-little-world",
  "private": true,
  "version": "0.1.0",
  "description": "Our Little World — Cozy 2D pixel-art home and private digital space for a long-distance couple",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "economy:sim": "node scripts/economy-sim.ts",
    "assets:generate": "node scripts/generate-starter-assets.mjs",
    "assets:atlas": "node scripts/build-unified-atlas.mjs",
    "assets:atlas:private": "node scripts/build-unified-atlas.mjs --private",
    "build:private": "tsc -b && vite build --mode private-art --outDir dist-private",
    "preview:private": "vite preview --outDir dist-private --host 127.0.0.1 --port 4174 --strictPort",
    "assets:import": "node scripts/import-external-assets.mjs",
    "spike:video": "node scripts/generate-spike-video.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.79.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
