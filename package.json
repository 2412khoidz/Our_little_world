{
  "name": "our-little-world",
  "private": true,
  "version": "0.1.0",
  "description": "Our Little World — Cozy 2D pixel-art home and private digital space for a long-distance couple",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pet-care-long": "OLW_ACCEPTANCE_LONG=1 playwright test tests/e2e/pet-care-session-acceptance.spec.ts --project=chromium-desktop",
    "test:e2e:pwa": "npm run build && playwright test -c playwright.pwa.config.ts",
    "economy:sim": "node scripts/economy-sim.ts",
    "economy:experiments": "node scripts/economy-experiments.ts",
    "assets:generate": "node scripts/generate-starter-assets.mjs",
    "assets:atlas": "node scripts/build-unified-atlas.mjs",
    "assets:atlas:private": "node scripts/build-unified-atlas.mjs --private",
    "build:private": "tsc -b && vite build --mode private-art --outDir dist-private",
    "verify:private": "node scripts/verify-private-build.mjs",
    "assets:check-demo-e": "node scripts/check-demo-e-sources.mjs",
    "assets:pack-demo-e-minimal": "node scripts/pack-demo-e-minimal.mjs",
    "preview:private": "vite preview --outDir dist-private --host 127.0.0.1 --port 4174 --strictPort",
    "assets:import": "node scripts/import-external-assets.mjs",
    "vendor-donor:cabacos-characters": "node scripts/vendor-donor-cabacos-characters.mjs",
    "vendor-donor:cabacos-maps": "node scripts/vendor-donor-cabacos-maps.mjs",
    "vendor-donor:cabacos-farming-art": "node scripts/vendor-donor-cabacos-farming-art.mjs",
    "vendor-donor:pydew-farming-art": "node scripts/vendor-donor-pydew-farming-art.mjs",
    "vendor-donor:pydew-characters": "node scripts/vendor-donor-pydew-characters.mjs",
    "assets:farming-transplant-sheet": "node scripts/build-farming-transplant-contact-sheet.mjs",
    "import-donor:cabacos": "node scripts/vendor-donor-cabacos-maps.mjs && node scripts/import-donor-cabacos.mjs",
    "import-donor:cabacos-farm": "node scripts/import-donor-cabacos-farm.mjs",
    "import-donor:cabacos-ui-inventory": "node scripts/import-donor-cabacos-ui-inventory.mjs",
    "import-donor:pydew-farm": "node scripts/vendor-donor-pydew-valley.mjs && node scripts/import-donor-pydew-farm.mjs",
    "import-donor:hollowmere-beach": "node scripts/import-donor-hollowmere-beach.mjs",
    "import-donor:cabacos-beach": "node scripts/import-donor-cabacos-beach.mjs",
    "import-donor:pydew-forest": "node scripts/import-donor-pydew-forest.mjs",
    "import-donor:tuxemon-forest": "node scripts/import-donor-tuxemon-forest.mjs",
    "vendor-donor:tuxemon-forest": "node scripts/vendor-donor-tuxemon-forest.mjs",
    "vendor-donor:sprout-home-garden": "node scripts/vendor-donor-sprout-home-garden.mjs",
    "vendor-donor:fishing-frenzy": "node scripts/vendor-donor-fishing-frenzy.mjs",
    "import-donor:sprout-home-garden": "node scripts/vendor-donor-sprout-home-garden.mjs && node scripts/import-donor-sprout-home-garden.mjs",
    "import-donor:world-zones": "node scripts/import-donor-cabacos.mjs && node scripts/import-donor-pydew-farm.mjs && node scripts/import-donor-cabacos-beach.mjs && node scripts/import-donor-tuxemon-forest.mjs && node scripts/import-donor-sprout-home-garden.mjs",
    "import-donor:recovery-world": "OLW_MAP_RECOVERY=1 npm run import-donor:world-zones",
    "spike:video": "node scripts/generate-spike-video.mjs",
    "test:sql": "node scripts/run-local-sql-suite.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@types/three": "^0.186.0",
    "lucide-react": "^1.79.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-pageflip": "^2.0.3",
    "three": "^0.186.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-arm64-msvc": "1.2.19",
    "@rolldown/binding-win32-x64-msvc": "1.2.19",
    "@rollup/rollup-win32-arm64-msvc": "4.68.8",
    "@rollup/rollup-win32-ia32-msvc": "4.68.8",
    "@rollup/rollup-win32-x64-gnu": "4.68.8",
    "@rollup/rollup-win32-x64-msvc": "4.68.8",
    "lightningcss-win32-arm64-msvc": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
